# PROCUREMENTIQ AI Environment Configuration
SECRET_KEY=procurementiq-super-secure-session-key-2026
PORT=5000

# Operational Mode
# When DEMO_MODE is true (default), all core calculations, 6-agent workflows,
# risk rules, and recommendation generation work 100% locally without external API keys.
DEMO_MODE=true

# LLM Provider Configuration
LLM_PROVIDER=gemini # 'gemini', 'ngrok', 'groq', 'openai', or 'demo'
NGROK_API_KEY=      # ngrok AI Gateway access key (for matter & explanations)
GROQ_API_KEY=       # Groq API key (alternative ultra-fast matter engine)
GEMINI_API_KEY=     # Google Gemini API key (for graphs & analytics)
OPENAI_API_KEY=


# Database & Upload Paths (Defaults to instance/procurementiq.db and uploads/)
DATABASE_PATH=instance/procurementiq.db
UPLOAD_FOLDER=uploads
